{
  "name": "Order",
  "type": "object",
  "properties": {
    "quote_id": { "type": "string" },
    "customer_id": { "type": "string" },
    "total": { "type": "integer" },
    "deposit_due": { "type": "integer" },
    "deposit_status": { "type": "string", "enum": ["unpaid", "paid_confirmed_by_maker"], "default": "unpaid" },
    "pickup_or_delivery_at": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["confirmed", "baking", "ready", "collected", "cancelled"],
      "default": "confirmed"
    },
    "notes": { "type": "string" },
    "reminders_sent": {
      "type": "array",
      "items": { "type": "object", "properties": { "kind": { "type": "string" }, "at": { "type": "string" } } },
      "description": "Reminders the maker has sent, so the same one is not offered again"
    }
  },
  "required": ["quote_id", "status"],
  "rls": {
    "create": {"user_condition": {"role": "admin"}},
    "read": {"user_condition": {"role": "admin"}},
    "update": {"user_condition": {"role": "admin"}},
    "delete": {"user_condition": {"role": "admin"}}
  }
}
