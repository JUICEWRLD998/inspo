{
  "name": "RateCard",
  "type": "object",
  "properties": {
    "maker_id": { "type": "string" },
    "currency": { "type": "string" },
    "tier_prices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "diameter_in": { "type": "number" }, "price": { "type": "integer" } },
        "required": ["diameter_in", "price"]
      }
    },
    "height_multiplier": { "type": "object", "description": "{standard: 1, tall: n}" },
    "finish_multipliers": { "type": "object", "description": "finish name -> multiplier" },
    "flavour_surcharges": { "type": "object", "description": "flavour -> integer surcharge" },
    "decoration_prices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "unit": { "type": "string", "enum": ["each", "flat"] },
          "price": { "type": "integer" },
          "price_max": { "type": "integer", "description": "top of a price range; price is the low end" }
        },
        "required": ["type", "unit", "price"]
      }
    },
    "rush_fee": {
      "type": "object",
      "properties": { "within_days": { "type": "number" }, "amount": { "type": "integer" } }
    },
    "delivery_fee": { "type": "integer" },
    "lead_time_days": { "type": "integer" },
    "finish_surcharges": { "type": "object", "description": "finish -> flat surcharge (additive cards)" },
    "height_surcharge": { "type": "object", "description": "{standard: 0, tall: n} flat surcharge per tall tier" },
    "rush_tiers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "within_days": { "type": "number" }, "percent": { "type": "number" } }
      }
    },
    "delivery_zones": { "type": "object", "description": "zone -> minimum delivery fee" },
    "deposit_percent": { "type": "integer" },
    "data_origin": { "type": "string", "enum": ["real", "sample"], "description": "sample = invented for testing" }
  },
  "required": ["maker_id", "currency", "tier_prices"],
  "rls": {
    "create": {"user_condition": {"role": "admin"}},
    "read": true,
    "update": {"user_condition": {"role": "admin"}},
    "delete": {"user_condition": {"role": "admin"}}
  }
}
